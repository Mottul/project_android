{
  "name": "prism",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Prism - local-first media converter. Your files never leave your device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/sync-ffmpeg-core.mjs && node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "fflate": "^0.8.2",
    "lucide-react": "^0.475.0",
    "mp4-muxer": "^5.1.5",
    "mp4box": "^0.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "webm-muxer": "^5.0.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/core-mt": "^0.12.10",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.74",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^5.0.1",
    "wgsl_reflect": "^1.6.0"
  }
}
