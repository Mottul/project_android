{
  "name": "folio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Folio - local-first document reader and editor for PDF, EPUB, images and text.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "assets": "node scripts/sync-pdfjs-assets.mjs && node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fflate": "^0.8.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "sharp": "^0.35.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  }
}
